---
// src/pages/404.astro
import HeaderUni from "@/components/HeaderUni.astro";
import Footer from "@/components/Footer.astro";
import { Image } from "astro:assets";
import img404 from "@/assets/img/404-NoBG.png";
---

<html lang="es">
  <head>
    <link
      rel="icon"
      type="image/png"
      href={`${import.meta.env.BASE_URL}favicon.png`}
    />

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - Página no encontrada | UNAHUR</title>
    <link rel="icon" type="image/png" href="./favicon.png" />
  </head>
  <body>
    <HeaderUni />

    <main class="error-container">
      <div class="content-card">
        <Image
          src={img404}
          alt="Error 404 - Página no encontrada"
          class="error-image"
        />
        <h2>¡Ups! Te perdiste en el recorrido</h2>
        <p>
          La página que estás buscando no existe, fue movida o no tenés permisos
          para acceder a este contenido.
        </p>
        <a href="/" class="btn-primary">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg
          >
          Volver al inicio
        </a>
      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  :root {
    --bg-dark: #0b0f19;
    --card-bg: #161e2e;
    --border-color: #26334d;
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --celeste-unahur: #009bc3;
    --celeste-hover: #0081a3;
  }

  body {
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    background-color: var(--bg-dark);
    color: var(--text-primary);
    margin: 0;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .error-container {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
  }

  .content-card {
    background-color: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    max-width: 600px;
    width: 100%;
    text-align: center;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
  }

  .error-image {
    width: 100%;
    max-width: 600px;
    height: auto;
    margin: 0 auto 0.2rem auto;
    display: block;
    object-fit: contain;
  }

  .error-code {
    font-size: 3.5rem;
    font-weight: 800;
    margin: 0;
    color: var(--celeste-unahur);
    line-height: 1;
  }

  h2 {
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0.75rem 0 0.5rem 0;
    color: var(--text-primary);
  }

  p {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin: 0 0 1.75rem 0;
    line-height: 1.5;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: var(--celeste-unahur);
    color: #ffffff;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.2s ease-in-out;
  }

  .btn-primary:hover {
    background-color: var(--celeste-hover);
    transform: translateY(-1px);
  }
</style>

